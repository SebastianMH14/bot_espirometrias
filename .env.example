# Copiar a .env y completar con valores reales. NUNCA commitear el .env real.

# ── Sunu ──────────────────────────────────────────────────
URL_NUBE=https://cemde.sunu.be
URL_REPORTE=
USUARIO=
PASSWORD=

# Una de: BELLO, SABANETA, LAURELES, ANTIOQUIA, RIO NEGRO
# (debe coincidir exactamente con el texto de la columna "sede" del Excel)
SEDE_LOCAL=

# Carpeta de descargas de Selenium, relativa a la raíz del proyecto
DOWNLOAD_PATH=downloads

# ── MirSpiro ──────────────────────────────────────────────
MIRSPIRO_EXE=
MIRSPIRO_TYPING_DELAY=0.05

# ── Email de reporte diario ──────────────────────────────
EMAIL_REMITENTE=
EMAIL_PASSWORD=
EMAIL_DESTINATARIOS=correo1@ejemplo.com,correo2@ejemplo.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# ── Selectores CSS/XPath (opcional, solo si Sunu cambia de UI) ──
# Dejar en blanco para usar los valores por defecto definidos en config.py
SEL_USERNAME=
SEL_PASSWORD=
SEL_LOGIN_BTN=
SEL_FECHA_INICIO=
SEL_FECHA_FIN=
SEL_FILTROS=
SEL_ENVIAR=
SEL_DOWNLOAD=
